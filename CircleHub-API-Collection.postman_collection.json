            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello CircleHub! This is my first post.\",\n  \"imageUrl\": \"https://example.com/image.jpg\",\n  \"circleId\": 1\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/posts/create",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "posts", "create"]
            }
          }
        },
