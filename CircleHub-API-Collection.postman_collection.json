              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/comments/post/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "comments", "post", "1"]
            }
          }
        }
      ]
    }
  ],
